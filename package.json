{
  "name": "thedot-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build -w @thedot/design-system && npm run sync-portfolio && next build",
    "start": "next start",
    "lint": "next lint",
    "sync-portfolio": "tsx scripts/sync-portfolio-from-notion.ts",
    "dev-with-sync": "npm run sync-portfolio && next dev --turbopack",
    "analyze": "ANALYZE=true npm run build",
    "generate-password": "tsx scripts/generate-admin-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "tsx scripts/test-rls.ts",
    "test:rls:seed-local": "tsx scripts/seed-rls-local.ts",
    "assistant-eval": "tsx scripts/assistant-eval.ts",
    "portal-admin": "tsx scripts/portal-admin.ts",
    "portal-write": "tsx scripts/portal-write.ts",
    "portal-schedule": "tsx scripts/portal-schedule.ts",
    "portal-inbox": "tsx scripts/portal-inbox.ts",
    "portal-history": "tsx scripts/import-portal-history.ts",
    "sync-content": "tsx scripts/sync-content-to-supabase.ts",
    "sync-content:fixtures": "PORTAL_CONTENT_DIR=content/portal tsx scripts/sync-content-to-supabase.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@google-analytics/data": "^5.2.1",
    "@notionhq/client": "^3.1.3",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.0",
    "jspdf": "^3.0.1",
    "next": "^15.3.8",
    "nodemailer": "^6.10.1",
    "openai": "^6.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.3.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.23.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.18.0"
}
